# HBTXR machine-local path bindings. Copy to .env and set for your machine.
# Code resolves logical roots through common.paths; it never hard-codes absolute
# paths. Every variable below is read by common/src/common/paths.py.

# Raw and cached datasets (events, frames, labels).
EVEYE_DATA_ROOT=/mnt/data/eveye/datasets

# Training/evaluation outputs: runs, logs, predictions, reports.
EVEYE_OUTPUT_ROOT=/mnt/data/eveye/outputs

# Reusable on-disk caches (memmaps, frame stacks).
EVEYE_CACHE_ROOT=/mnt/data/eveye/cache

# Model checkpoints / pretrained weights.
EVEYE_CHECKPOINT_ROOT=/mnt/data/eveye/checkpoints

# Vendored external assets (GroundedSAM, TimeLens-XL, etc.).
EVEYE_EXTERNAL_ROOT=/mnt/data/eveye/external
