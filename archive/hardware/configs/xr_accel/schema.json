{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbtxr.local/schemas/xr-accel-manifest-v1.json",
  "title": "HBTXR XR accelerator normalized manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_name",
    "links",
    "records",
    "clocks",
    "interface",
    "memory_topology",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "hbtxr.xr-accel-manifest/v1"
    },
    "experiment_name": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "model", "design", "target"],
      "properties": {
        "experiment": {"type": "string", "pattern": "^configs/experiments/[A-Za-z0-9_.-]+\\.json$"},
        "model": {"type": "string", "pattern": "^configs/models/[A-Za-z0-9_.-]+\\.json$"},
        "design": {"type": "string", "pattern": "^configs/designs/[A-Za-z0-9_.-]+\\.json$"},
        "target": {"type": "string", "pattern": "^configs/targets/[A-Za-z0-9_.-]+\\.json$"}
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "model", "design", "target"],
      "properties": {
        "experiment": {"type": "object"},
        "model": {"type": "object"},
        "design": {"type": "object"},
        "target": {"type": "object"}
      }
    },
    "clocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_period_ns", "design_period_ns", "board_period_ns"],
      "properties": {
        "target_period_ns": {"type": "number", "exclusiveMinimum": 0},
        "design_period_ns": {"type": "number", "exclusiveMinimum": 0},
        "board_period_ns": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axi_data_width_bits", "control", "top_module"],
      "properties": {
        "axi_data_width_bits": {"const": 32},
        "control": {"const": "runtime_mmio"},
        "top_module": {"type": ["string", "null"]}
      }
    },
    "memory_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "regions"],
      "properties": {
        "type": {"const": "runtime_mmio"},
        "regions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "base_address"],
            "properties": {
              "name": {"enum": ["dma", "gpio", "clock", "accelerator"]},
              "base_address": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_revision", "evidence_policy", "source_hashes"],
      "properties": {
        "source_repository": {"const": "HANDOVER/XR_Accel"},
        "source_revision": {"const": "5041401aec53a1c85a58661203b8bee60dacbfca"},
        "evidence_policy": {"const": "structural-reference-only"},
        "source_hashes": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "x-normalization-policy": {
    "schema_version": "hbtxr.xr-accel-manifest/v1",
    "source_repository": "HANDOVER/XR_Accel",
    "source_revision": "5041401aec53a1c85a58661203b8bee60dacbfca",
    "evidence_policy": "structural-reference-only",
    "supported_targets": [
      {
        "name": "zcu104",
        "part": "xczu7ev-ffvc1156-2-e",
        "board_part": "xilinx.com:zcu104:part0:1.1"
      }
    ],
    "axi_data_width_bits": 32,
    "interface_control": "runtime_mmio",
    "memory_topology": "runtime_mmio",
    "board_clock_rule": "design_override_or_target",
    "required_runtime_regions": ["dma", "gpio", "clock", "accelerator"]
  }
}
