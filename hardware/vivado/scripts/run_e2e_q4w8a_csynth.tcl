proc hgtxr_env_default {name default} {
  if {[info exists ::env($name)] && $::env($name) ne ""} {
    return $::env($name)
  }
  return $default
}
proc hgtxr_e2e_project_name {default_name} {
  if {[info exists ::env(HGTXR_E2E_PROJECT_NAME)] && $::env(HGTXR_E2E_PROJECT_NAME) ne ""} {
    if {![regexp {^[A-Za-z0-9_]+$} $::env(HGTXR_E2E_PROJECT_NAME)]} {
      error "Unsupported HGTXR_E2E_PROJECT_NAME: $::env(HGTXR_E2E_PROJECT_NAME) (use A-Z, a-z, 0-9, _)"
    }
    return $::env(HGTXR_E2E_PROJECT_NAME)
  }
  if {[info exists ::env(HGTXR_E2E_RUN_TAG)] && $::env(HGTXR_E2E_RUN_TAG) ne ""} {
    if {![regexp {^[A-Za-z0-9_]+$} $::env(HGTXR_E2E_RUN_TAG)]} {
      error "Unsupported HGTXR_E2E_RUN_TAG: $::env(HGTXR_E2E_RUN_TAG) (use A-Z, a-z, 0-9, _)"
    }
    return "${default_name}_$::env(HGTXR_E2E_RUN_TAG)"
  }
  return $default_name
}
