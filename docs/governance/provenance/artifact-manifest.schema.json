{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbtxr.local/schemas/artifact-manifest.schema.json",
  "title": "HBTXR external artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_type", "status", "content", "inputs", "environment", "governance", "generation", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "artifact_type": {
      "enum": ["MODEL_CHECKPOINT", "DATASET", "HDF5", "RAW_PREDICTIONS", "RUN_LOG", "HLS_PROJECT", "BUILD_OUTPUT", "BITSTREAM", "HWH", "XSA", "DCP", "IP_ARCHIVE"]
    },
    "status": {"enum": ["DECLARED", "AVAILABLE", "VALIDATED", "BLOCKED", "RETIRED"]},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_count", "uri", "replacement_sha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
        "replacement_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "config_sha256", "split_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "split_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_version", "tool_version", "board_version"],
      "properties": {
        "architecture_version": {"$ref": "#/$defs/nonempty"},
        "tool_version": {"$ref": "#/$defs/nonempty"},
        "board_version": {"$ref": "#/$defs/nonempty"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "privacy", "license"],
      "properties": {
        "access": {"enum": ["PUBLIC", "RESTRICTED", "PRIVATE", "UNAVAILABLE"]},
        "privacy": {"enum": ["PUBLIC_NO_SUBJECT_DATA", "DEIDENTIFIED", "SUBJECT_LEVEL_SENSITIVE", "UNKNOWN"]},
        "license": {"enum": ["VERIFIED", "RESTRICTED", "UNVERIFIED", "NOT_APPLICABLE"]}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status"],
      "properties": {
        "command": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["NOT_GENERATED", "GENERATED", "FAILED", "UNKNOWN"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "date", "claims"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonempty"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["HASH_VERIFIED", "SIZE_VERIFIED", "URI_SYNTAX_VERIFIED", "LICENSE_REVIEWED", "PRIVACY_REVIEWED"]}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 1024}
  }
}
